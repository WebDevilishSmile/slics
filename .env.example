# Copy to `.env` and fill in. Next.js loads `.env` (and `.env.local`) automatically;
# the `scripts/*` npm tasks read `.env` explicitly via `node --env-file=.env`.
# Every key below is read somewhere in the code — nothing here is optional.

# MongoDB connection string. Leave the database name OUT of the path: the driver's
# implicit default (`test`) is the database every `client.db()` call resolves to.
MONGODB_URI=

# Auth.js session/JWT signing secret. Generate one with `npx auth secret`.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → Credentials → OAuth 2.0 Client ID).
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Gemini API key — used by `app/api/coverBidJobs/extract` to parse uploaded bid sheets.
GEMINI_API_KEY=

# Shared secret configured on the Buy Me a Coffee webhook (`app/api/webhooks/buymeacoffee`).
BMC_WEBHOOK_SECRET=

# Vercel Blob read/write token for slic direction PDFs (`lib/blob.js`). Vercel injects
# it once a Blob store is connected to the project; `vercel env pull` brings it down
# locally (along with a few `BLOB_*` siblings the app doesn't read).
BLOB_READ_WRITE_TOKEN=
